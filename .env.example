NODE_ENV=development
PORT=3000
QUICKREACH_MODE=demo
DATA_DIR=./data

# Public HTTPS origin for media attachments in live campaigns.
PUBLIC_BASE_URL=https://your-domain.example
META_GRAPH_API_VERSION=v24.0

# App login; required when NODE_ENV=production.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password

# Meta WhatsApp Business Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Meta Instagram Messaging API (eligible professional account)
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_PAGE_ID=

# Meta webhook verification and signature validation
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
